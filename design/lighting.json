{
 "types": {
  "L1": {
   "layer": "wall",
   "name": "Wall grazer in ceiling slot",
   "spec": "Dot-free COB line, 2700 K, CRI 95 (R9 > 50), 10 W/m ≈ 900 lm/m, 10×60° asymmetric lens, 60 mm from the wall, DALI-2 dim to 0.1%",
   "why": "Draws light down the wall so limewash, clay and fluted oak show their texture"
  },
  "L2": {
   "layer": "wall",
   "name": "Curtain-pocket wash",
   "spec": "COB line in the curtain recess, 2700 K, 6 W/m, 40° lens, dim to 0.1%",
   "why": "Turns closed linen sheers into a soft luminous wall"
  },
  "L3": {
   "layer": "night",
   "name": "Plinth glow",
   "spec": "Opal COB line under floating joinery, 2200 K, 4 W/m, dim to 1%",
   "why": "Makes joinery float, and doubles as the night path at 5%"
  },
  "L4": {
   "layer": "task",
   "name": "Task line",
   "spec": "Deep aluminium profile with opal cover, 2700 K, CRI 95, 12 W/m",
   "why": "Shadow-free light on worktops, niches and book ledges"
  },
  "L5": {
   "layer": "task",
   "name": "Mirror face light",
   "spec": "Vertical or halo lines either side of the mirror, 2700 K, CRI 95, about 300 lx on the face, IP44",
   "why": "Light from the front, so there are no shadows under the eyes"
  },
  "D1": {
   "layer": "task",
   "name": "Recessed downlight",
   "spec": "Trimless Ø55 mm, source set back ≥ 35 mm (40° cut-off), 7 W ≈ 500 lm, 2700 K, CRI 95, 36° beam; IP65 version in wet zones",
   "why": "Only where hands work or faces meet; never over a sofa or a bed"
  },
  "D2": {
   "layer": "accent",
   "name": "Pinhole accent",
   "spec": "Trimless Ø30 mm, adjustable ±35°, 4 W, 12° beam, 2700 K, CRI 97, honeycomb louvre",
   "why": "A tight pool on art and stone; the fitting itself is nearly invisible"
  },
  "P1": {
   "layer": "decor",
   "name": "Washi pendant Ø80",
   "spec": "Existing paper pendant over the coffee table, dim-to-warm lamp 2700 → 1800 K, hung 1.75 m above the floor",
   "why": "The one visible lamp in the room: the lantern you sit under"
  },
  "P2": {
   "layer": "decor",
   "name": "Small washi pendants Ø44",
   "spec": "Pair over the peninsula, 0.75 m above the top, opal inner diffuser, dim-to-warm",
   "why": "Light on the faces at the bar without glare in the eyes"
  },
  "P3": {
   "layer": "decor",
   "name": "Paper column floor lamp",
   "spec": "NEW. Ø45 × h 1.60, handmade washi on bamboo ribs, dim-to-warm 2700 → 1800 K. Replaces the olive tree",
   "why": "A tall glow in the corner by the glass that balances the view at dusk"
  },
  "P4": {
   "layer": "decor",
   "name": "Washi floor lantern",
   "spec": "Existing, h 1.40, beside the sofa behind the slatted screen",
   "why": "Glows through the slats when you open the front door"
  },
  "P5": {
   "layer": "decor",
   "name": "Paper bedside lamp",
   "spec": "Small paper table lamp, 1800–2700 K dim-to-warm, touch dimmer",
   "why": "The warm low glow you fall asleep by"
  },
  "R1": {
   "layer": "task",
   "name": "Wall reading light",
   "spec": "Articulated arm, 3 W, 2700 K, 20° beam with louvre, touch dimmer at the head",
   "why": "Reads a book without waking the person next to you"
  },
  "O1": {
   "layer": "task",
   "name": "Desk pendant, direct / indirect",
   "spec": "Linear 1.20 m, 30% down / 70% up, tunable 2700–4000 K, UGR < 16",
   "why": "Bright, even desk light with no glare on the screen; the ceiling glows"
  },
  "B1": {
   "layer": "accent",
   "name": "Screen bias light",
   "spec": "Line behind the screen, 2700 K, 3 W/m; RGBW option in the game room",
   "why": "Rests the eyes in a dark room and makes the screen look deeper"
  },
  "K1": {
   "layer": "decor",
   "name": "Flush opal disc Ø60",
   "spec": "Fully diffuse, no visible LED, dim-to-warm 2700 → 1800 K, dims to 0.1%",
   "why": "Soft play light with nothing for a small child to look into"
  },
  "T1": {
   "layer": "task",
   "name": "Surface track, three mini spots",
   "spec": "Surface-mounted, no cutting into the ceiling, 3 × 5 W, 2700 K, 30° beams",
   "why": "Safe-room rules allow no recessed fittings, so the track does the work"
  },
  "W1": {
   "layer": "task",
   "name": "Wardrobe interior light",
   "spec": "Line inside each door bay, 2700 K, CRI 95, door-contact switch",
   "why": "See true colours when you choose clothes"
  },
  "N1": {
   "layer": "night",
   "name": "Step light",
   "spec": "Recessed in the wall 0.30 m above the floor, 1.5 W, 2200 K, louvred so only the floor lights, presence sensor 23:00–06:00",
   "why": "Find the way at night without waking up"
  },
  "E1": {
   "layer": "outdoor",
   "name": "Soffit grazer",
   "spec": "IP65 line under the balcony soffit, 2700 K, 6 W/m, washes the façade down",
   "why": "Gives the balcony back wall a soft glow, so the glass shows the outside and not a mirror"
  },
  "E2": {
   "layer": "outdoor",
   "name": "Spike uplight",
   "spec": "IP67, 5 W, 2200 K, 15° beam, glare shield, in the planters",
   "why": "Lights the olive and the grasses from below: the silhouette against the bay"
  },
  "E3": {
   "layer": "outdoor",
   "name": "Outdoor plinth glow",
   "spec": "IP67 opal line under the sofa base and the planter lip, 2200 K, 4 W/m",
   "why": "Low light on the plank floor that keeps the eye level clear for the view"
  },
  "E4": {
   "layer": "outdoor",
   "name": "Rechargeable table lamp",
   "spec": "Portable, 2200 K, 150 lm, dims by touch",
   "why": "Candle-level light at the table; nothing overhead between you and the stars"
  }
